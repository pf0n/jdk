<?xml version="1.0" encoding="UTF-8"?>
<configuration version="2.0" label="ObjectCountAfterGC"
               description="Minimal recording: only the events needed to verify jdk.ObjectCountAfterGC against a specific GC.">

  <event name="jdk.ObjectCountAfterGC">
    <setting name="enabled">true</setting>
  </event>
</configuration>
